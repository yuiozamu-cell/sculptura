# ==============================================================================
# SCULPTURA - Environment Variables Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Do NOT commit your actual .env file with real credentials to GitHub.
# - In Vite, only variables prefixed with VITE_ are exposed to the client bundle.
# - Use your Supabase project URL and your 'anon' / 'publishable' client key.
# - NEVER put your service_role (secret) key here!
#
# Setup Steps:
# 1. Copy this file to .env:
#    cp .env.example .env   (or rename a copy in your editor)
# 2. Open your Supabase Dashboard: https://supabase.com/dashboard/project/_/settings/api
# 3. Replace the placeholder values below with your Project URL and anon public key.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here
